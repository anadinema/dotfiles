# Get all non-loopback IPv4 addresses

local public_ip ipv4 ip index=1

# Local IPv4 addresses
while IFS= read -r ip; do
  printf 'Local IP address %d\t%s\n' "$index" "$ip"
  index=$((index + 1))
done < <(
  ifconfig |
    awk '/^[[:space:]]*inet / && $2 != "127.0.0.1" { print $2 }'
)

# Public IP
public_ip="$(curl -fsS --max-time 5 https://api64.ipify.org 2>/dev/null | tr -d '[:space:]')"

if [ -n "$public_ip" ]; then
  printf 'Public IP address\t%s\n' "$public_ip"
else
  printf 'Public IP address\tN/A\n'
  return
fi

# If the public IP is IPv6, also get IPv4
if ! [[ "$public_ip" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]]; then
  ipv4="$(curl -4 -fsS --max-time 5 https://api4.ipify.org 2>/dev/null | tr -d '[:space:]')"

  if [[ "$ipv4" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]]; then
    printf 'Public IPv4 address\t%s\n' "$ipv4"
  fi
fi
